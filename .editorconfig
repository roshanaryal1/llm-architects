# EditorConfig — https://editorconfig.org
# Keeps Markdown + CSV + Python consistent across contributors' editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown: trailing whitespace can be a hard line break; leave it, but still normalise EOL.
trim_trailing_whitespace = false
max_line_length = off

[*.py]
indent_size = 4

[*.csv]
trim_trailing_whitespace = false
insert_final_newline = true

[Makefile]
indent_style = tab
